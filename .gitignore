.test-*/
.coverage
dwarf_python_api/
build/
dist/
DwarfAlpacaGUI.spec
logs/
dwarfii_api/
apk/*.apk
apk/*.apks
.vscode/settings.json

# Disposable firmware extraction and decompiler output. Keep only curated
# metadata, scripts, and documentation under version control.
firmware-analysis/extracted/
firmware-analysis/work/
firmware-analysis/ghidra-projects/

# Original vendor firmware may contain embedded network credentials and is
# retained locally only. Commit hashes, inventories, and redacted metadata.
firmware/*.zip

# Keep model-specific DRACO reverse-engineering notes local until they are
# intentionally reviewed and published.
docs/apk-analysis/DRACO_LOCAL.md
